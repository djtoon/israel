# Whitelist: only the game project, its tools, sources, docs and build/trailer scripts are tracked.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/*.md
!/PLAY_CURRENT.bat
!/game/
!/tools/
!/sources/
!/build/
/build/*
!/build/full/
/build/full/*
!/build/full/*.sh
!/build/full/*.py
!/dev_update/
/dev_update/*
!/dev_update/gameplay/
/dev_update/gameplay/*
!/dev_update/gameplay/*.sh
!/dev_update/gameplay/*.py
!/dev_update/gameplay/plans/
!/trailer_v5/
/trailer_v5/*
!/trailer_v5/make_trailer.py
!/trailer_v6/
/trailer_v6/*
!/trailer_v6/BREAKDOWN.md
!/trailer_v6/src/
/trailer_v6/src/*
!/trailer_v6/src/scripts/

# Godot caches and local state
.godot/
*.tmp
game/logs/
__pycache__/
*.pyc
tools/map_cache/
tools/.source_cache/
